{
  "name": "time-tracking",
  "version": "2.0.1",
  "description": "Lean desktop time tracker for Windows — local, no cloud.",
  "main": "./out/main/index.js",
  "author": "wald-it",
  "license": "MIT",
  "homepage": "https://github.com/wald-it/time-tracking",
  "repository": {
    "type": "git",
    "url": "https://github.com/wald-it/time-tracking.git"
  },
  "bugs": {
    "url": "https://github.com/wald-it/time-tracking/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:mcp": "tsc --noEmit -p tsconfig.mcp.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:mcp",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "mcp": "node scripts/run-mcp.mjs",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:ui": "node scripts/run-vitest.mjs --ui",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "sync-icon": "node scripts/sync-icon.mjs",
    "prebuild": "npm run sync-icon && node scripts/generate-licenses.mjs",
    "build": "npm run typecheck && npm run build:mcp && electron-vite build",
    "postinstall": "node scripts/ensure-electron.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.11",
    "ms": "^2.1.3",
    "pdf-lib": "^1.17.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.1.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.0.2",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller"
    ]
  }
}
